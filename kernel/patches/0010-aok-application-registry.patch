+/*
+ * Reinject a persisted snapshot into an empty durable queue and continue
+ * the id/sequence space past the restored records. A non-empty queue, a
+ * mismatched application_id or non-monotonic records reject the restore.
+ */
+SYSCALL_DEFINE3(aok_application_restore, int, fd,
+		const struct aok_event_record __user *, urecs, u64, count)
+{
+	struct aok_event_record *records;
+	struct aok_app_file *handle;
+	struct aok_application *app;
+	struct fd f;
+	u64 i;
+	int ret;
+
+	if (count > AOK_APP_QUEUE_DEPTH)
+		return -EINVAL;
+	f = fdget(fd);
+	if (fd_empty(f))
+		return -EBADF;
+	if (fd_file(f)->f_op != &aok_app_fops) {
+		fdput(f);
+		return -EINVAL;
+	}
+	handle = fd_file(f)->private_data;
+	if (!(handle->rights & AOK_RIGHT_WRITE)) {
+		fdput(f);
+		return -EACCES;
+	}
+	app = handle->app;
+	if (!count) {
+		fdput(f);
+		return 0;
+	}
+	records = kvmalloc_array(count, sizeof(*records), GFP_KERNEL);
+	if (!records) {
+		fdput(f);
+		return -ENOMEM;
+	}
+	if (copy_from_user(records, urecs, count * sizeof(*records))) {
+		ret = -EFAULT;
+		goto out;
+	}
+	for (i = 0; i < count; i++) {
+		struct aok_event_record *rec = &records[i];
+
+		if (rec->size != sizeof(*rec) ||
+		    rec->application_id != app->application_id ||
+		    !rec->kind || rec->kind > AOK_EVENT_KIND_LSFS ||
+		    rec->reserved[0] || rec->reserved[1]) {
+			ret = -EINVAL;
+			goto out;
+		}
+		if (i && (rec->event_id <= records[i - 1].event_id ||
+			  rec->event_seq <= records[i - 1].event_seq)) {
+			ret = -EINVAL;
+			goto out;
+		}
+	}
+	spin_lock_irq(&app->lock);
+	if (app->live || app->coalesced) {
+		spin_unlock_irq(&app->lock);
+		ret = -EBUSY;
+		goto out;
+	}
+	for (i = 0; i < count; i++) {
+		struct aok_app_node *node = &app->nodes[i];
+
+		node->used = true;
+		node->event_id = records[i].event_id;
+		node->event_seq = records[i].event_seq;
+		node->source_koid = records[i].source_koid;
+		node->kind = records[i].kind;
+		node->coalesced = records[i].coalesced;
+		node->data = records[i].data;
+		list_add_tail(&node->list, &app->pending);
+	}
+	app->live = count;
+	/* Ids are never reused within a boot: continue past both the restored
+	 * records and anything this boot already issued, whichever is larger. */
+	if (records[count - 1].event_id > app->event_id)
+		app->event_id = records[count - 1].event_id;
+	if (records[count - 1].event_seq > app->event_seq)
+		app->event_seq = records[count - 1].event_seq;
+	spin_unlock_irq(&app->lock);
+	aok_app_notify(app);
+	ret = 0;
+out:
+	kvfree(records);
+	fdput(f);
+	return ret;
+}
