+/*
+ * Create is idempotent per boot: an existing registry entry with the same
+ * application_id is re-opened with a fresh cursor, which is the recovery
+ * path after a supervisor restart. New ids allocate a registry entry whose
+ * permanent reference keeps the durable queue alive until reboot.
+ */
+SYSCALL_DEFINE2(aok_application_create,
+		const struct aok_application_attr __user *, uattr,
+		struct aok_object_info __user *, uinfo)
+{
+	struct aok_object_info info = {
+		.size = sizeof(info),
+		.type = AOK_OBJECT_APPLICATION,
+	};
+	struct aok_application_attr attr;
+	struct aok_app_file *handle;
