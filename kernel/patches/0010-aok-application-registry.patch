+			return -ENOMEM;
+		}
+		ret = aok_alloc_id(&aok_next_koid, &app->koid);
+		if (ret) {
+			kfree(app);
+			mutex_unlock(&aok_apps_lock);
+			return ret;
+		}
+		refcount_set(&app->refs, 1); /* the registry itself */
+		spin_lock_init(&app->lock);
+		init_waitqueue_head(&app->wait);
+		INIT_LIST_HEAD(&app->pending);
+		for (i = 0; i < AOK_APP_QUEUE_DEPTH; i++)
+			INIT_LIST_HEAD(&app->nodes[i].list);
+		app->application_id = attr.application_id;
+		list_add(&app->list, &aok_apps);
