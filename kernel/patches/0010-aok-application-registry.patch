+	struct fd parent;
+	struct file *file;
+	int fd, ret, i;
+
+	ret = aok_copy_app_attr(&attr, uattr);
+	if (ret)
+		return ret;
+	parent = fdget(attr.parent_job_fd);
+	if (fd_empty(parent))
+		return -EBADF;
+	if (fd_file(parent)->f_op != &aok_root_fops &&
+	    fd_file(parent)->f_op != &aok_aproc_fops) {
+		fdput(parent);
+		return -EINVAL;
+	}
+	if (!(fd_file(parent)->private_data &&
+	      ((struct aok_handle *)fd_file(parent)->private_data)->rights &
+	      AOK_RIGHT_MANAGE_CHILD)) {
+		fdput(parent);
+		return -EACCES;
+	}
+	fdput(parent);
