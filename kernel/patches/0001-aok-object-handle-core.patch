@@ -0,0 +1,19 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _LINUX_AOK_H
+#define _LINUX_AOK_H
+
+#include <linux/refcount.h>
+#include <linux/types.h>
+
+struct aok_aproc {
+	refcount_t refs;
+	u64 aid;
+	u32 state;
+};
+
+struct aok_handle {
+	struct aok_aproc *aproc;
+	u64 rights;
+};
+
+#endif /* _LINUX_AOK_H */
