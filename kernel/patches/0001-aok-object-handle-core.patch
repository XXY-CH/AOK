diff --git a/include/uapi/linux/aok.h b/include/uapi/linux/aok.h
new file mode 100644
index 000000000..3a35db99e
--- /dev/null
+++ b/include/uapi/linux/aok.h
@@ -0,0 +1,33 @@
+/* SPDX-License-Identifier: GPL-2.0 WITH Linux-syscall-note */
+#ifndef _UAPI_LINUX_AOK_H
+#define _UAPI_LINUX_AOK_H
+
+#include <linux/types.h>
+
+#define AOK_OBJECT_APROC 1U
+#define AOK_APROC_STATE_CREATED 0U
+
+#define AOK_RIGHT_INSPECT (1ULL << 0)
+#define AOK_RIGHT_DUPLICATE (1ULL << 1)
+#define AOK_RIGHTS_INITIAL (AOK_RIGHT_INSPECT | AOK_RIGHT_DUPLICATE)
+
+/* Experimental object-only bootstrap, restricted to the initial PID 1. */
+#define AOK_PARENT_BOOTSTRAP (-1)
+
+struct aok_aproc_create_args {
+	__u64 size;
+	__s32 parent_job_fd;
+	__u32 flags;
+	__u64 reserved[3];
+};
+
+struct aok_object_info {
+	__u64 size;
+	__u64 aid;
+	__u32 type;
+	__u32 state;
+	__u64 rights;
+	__u64 reserved[3];
+};
+
+#endif /* _UAPI_LINUX_AOK_H */
