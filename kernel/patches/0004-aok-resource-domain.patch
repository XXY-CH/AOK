+static int aok_copy_budget_in(struct aok_budget *budget,
+			      const struct aok_budget __user *ubudget)
+{
+	u64 size;
+	int ret;
+
+	if (get_user(size, &ubudget->size))
+		return -EFAULT;
+	if (size < sizeof(*budget) || size > PAGE_SIZE)
+		return -EINVAL;
+	ret = copy_struct_from_user(budget, sizeof(*budget), ubudget, size);
+	if (ret)
+		return ret;
+	if (budget->size != size || budget->flags ||
+	    budget->reserved[0] || budget->reserved[1])
+		return -EINVAL;
+	return 0;
+}
+
+static int aok_copy_usage_in(struct aok_token_usage *usage,
+			     const struct aok_token_usage __user *uusage)
+{
+	u64 size;
+	int ret;
+
+	if (get_user(size, &uusage->size))
+		return -EFAULT;
+	if (size < sizeof(*usage) || size > PAGE_SIZE)
+		return -EINVAL;
+	ret = copy_struct_from_user(usage, sizeof(*usage), uusage, size);
+	if (ret)
+		return ret;
+	if (usage->size != size || usage->reserved[0] || usage->reserved[1] ||
+	    !usage->usage_id || !usage->usage_seq)
+		return -EINVAL;
+	return 0;
+}
+
+static int aok_copy_status_out(struct aok_budget_status __user *ustatus,
+			       const struct aok_budget_status *status)
+{
+	u64 size;
+
+	if (get_user(size, &ustatus->size))
+		return -EFAULT;
+	if (size < sizeof(*status) || size > PAGE_SIZE)
+		return -EINVAL;
+	return copy_struct_to_user(ustatus, size, status, sizeof(*status), NULL);
+}
+
+/*
+ * Observe CPU time and RSS of the current members. Neither value feeds an
+ * enforcement path in this slice; racy reads approximate per-task counters
+ * without perturbing the scheduler or reclaim.
+ */
+static void aok_observe_usage(struct aok_aproc *aproc, u64 *cpu_ns, u64 *bytes)
+{
+	struct task_struct **tasks;
+	unsigned int count, i;
+	u64 ns = 0, rss = 0;
+
+	tasks = aok_collect_tasks(aproc, &count);
+	if (IS_ERR(tasks))
+		return;
+	for (i = 0; i < count; i++) {
+		struct mm_struct *mm;
+
+		ns = aok_sat_add(ns, READ_ONCE(tasks[i]->se.sum_exec_runtime));
+		mm = get_task_mm(tasks[i]);
+		if (mm) {
+			rss = aok_sat_add(rss,
+					  (u64)get_mm_counter(mm, MM_FILEPAGES));
+			rss = aok_sat_add(rss,
+					  (u64)get_mm_counter(mm, MM_ANONPAGES));
+			rss = aok_sat_add(rss,
+					  (u64)get_mm_counter(mm, MM_SHMEMPAGES));
+			mmput(mm);
+		}
+	}
+	aok_put_tasks(tasks, count);
+	*cpu_ns = ns;
+	*bytes = rss;
+}
+
+SYSCALL_DEFINE2(aok_budget_set, int, fd,
+		const struct aok_budget __user *, ubudget)
+{
+	struct aok_budget budget;
+	struct aok_handle *handle;
+	struct aok_aproc *aproc;
+	struct fd f;
+	int ret;
+
+	ret = aok_copy_budget_in(&budget, ubudget);
+	if (ret)
+		return ret;
+	if (budget.token_reserve > budget.token_hard_limit)
+		return -EINVAL;
+	f = fdget(fd);
+	if (fd_empty(f))
+		return -EBADF;
+	if (fd_file(f)->f_op != &aok_aproc_fops) {
+		fdput(f);
+		return -EINVAL;
+	}
+	handle = fd_file(f)->private_data;
+	aproc = handle->aproc;
+	if (!(handle->rights & AOK_RIGHT_SET_POLICY)) {
+		fdput(f);
+		return -EACCES;
+	}
+	spin_lock(&aproc->lock);
+	switch (aproc->state) {
+	case AOK_APROC_STATE_RUNNING:
+	case AOK_APROC_STATE_FROZEN:
+		break;
+	default:
+		spin_unlock(&aproc->lock);
+		fdput(f);
+		return -EINVAL;
+	}
+	/* Limits are monotonic: a set can only narrow each dimension. */
+	if (budget.cpu_usec_limit > aproc->res_cpu_limit ||
+	    budget.memory_bytes_limit > aproc->res_mem_limit ||
+	    budget.token_reserve > aproc->res_token_reserve ||
+	    budget.token_hard_limit > aproc->res_token_hard) {
+		spin_unlock(&aproc->lock);
+		fdput(f);
+		return -EPERM;
+	}
+	aproc->res_cpu_limit = budget.cpu_usec_limit;
+	aproc->res_mem_limit = budget.memory_bytes_limit;
+	aproc->res_token_reserve = budget.token_reserve;
+	aproc->res_token_hard = budget.token_hard_limit;
+	aok_res_eval_locked(aproc);
+	spin_unlock(&aproc->lock);
+	fdput(f);
+	return 0;
+}
+
+SYSCALL_DEFINE2(aok_budget_get, int, fd,
+		struct aok_budget_status __user *, ustatus)
+{
+	struct aok_budget_status status = { .size = sizeof(status), };
+	struct aok_handle *handle;
+	struct aok_aproc *aproc;
+	struct fd f;
+	u64 cpu_ns = 0, bytes = 0;
+
+	f = fdget(fd);
+	if (fd_empty(f))
+		return -EBADF;
+	if (fd_file(f)->f_op != &aok_aproc_fops) {
+		fdput(f);
+		return -EINVAL;
+	}
+	handle = fd_file(f)->private_data;
+	aproc = handle->aproc;
+	if (!(handle->rights & AOK_RIGHT_INSPECT)) {
+		fdput(f);
+		return -EACCES;
+	}
+	aok_observe_usage(aproc, &cpu_ns, &bytes);
+	spin_lock(&aproc->lock);
+	status.cpu_usec_limit = aproc->res_cpu_limit;
+	status.cpu_usec_used = div64_u64(cpu_ns, 1000);
+	status.memory_bytes_limit = aproc->res_mem_limit;
+	status.memory_bytes_used = bytes;
+	status.token_reserve = aproc->res_token_reserve;
+	status.token_hard_limit = aproc->res_token_hard;
+	status.tokens_used = aproc->tokens_used;
+	status.tokens_cached = aproc->tokens_cached;
+	status.res_state = aproc->res_state;
+	spin_unlock(&aproc->lock);
+	fdput(f);
+	return aok_copy_status_out(ustatus, &status);
+}
+
+SYSCALL_DEFINE2(aok_token_usage, int, fd,
+		const struct aok_token_usage __user *, uusage)
+{
+	struct aok_token_usage usage;
+	struct aok_handle *handle;
+	struct aok_aproc *aproc;
+	struct fd f;
+	u64 delta, settled;
+	int ret;
+
+	ret = aok_copy_usage_in(&usage, uusage);
+	if (ret)
+		return ret;
+	f = fdget(fd);
+	if (fd_empty(f))
+		return -EBADF;
+	if (fd_file(f)->f_op != &aok_aproc_fops) {
+		fdput(f);
+		return -EINVAL;
+	}
+	handle = fd_file(f)->private_data;
+	aproc = handle->aproc;
+	if (!(handle->rights & AOK_RIGHT_ACCOUNT)) {
+		fdput(f);
+		return -EACCES;
+	}
+	spin_lock(&aproc->lock);
+	switch (aproc->state) {
+	case AOK_APROC_STATE_RUNNING:
+	case AOK_APROC_STATE_FROZEN:
+		break;
+	default:
+		spin_unlock(&aproc->lock);
+		fdput(f);
+		return -EINVAL;
+	}
+	/* Replaying the last accepted report settles identically. */
+	if (usage.usage_id == aproc->last_usage_id) {
+		spin_unlock(&aproc->lock);
+		fdput(f);
+		return 0;
+	}
+	if (usage.usage_seq <= aproc->last_usage_seq) {
+		spin_unlock(&aproc->lock);
+		fdput(f);
+		return -EINVAL;
+	}
+	delta = aok_sat_add(usage.input_tokens, usage.output_tokens);
+	settled = aok_sat_add(aproc->tokens_used, delta);
+	if (aproc->res_token_hard != U64_MAX &&
+	    settled > aproc->res_token_hard) {
+		spin_unlock(&aproc->lock);
+		fdput(f);
+		return -EDQUOT;
+	}
+	aproc->tokens_used = settled;
+	aproc->tokens_cached = aok_sat_add(aproc->tokens_cached,
+					   usage.cached_tokens);
+	aproc->last_usage_id = usage.usage_id;
+	aproc->last_usage_seq = usage.usage_seq;
+	aok_res_eval_locked(aproc);
+	spin_unlock(&aproc->lock);
+	fdput(f);
+	return 0;
+}
+
