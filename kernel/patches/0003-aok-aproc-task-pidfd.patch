+SYSCALL_DEFINE2(aok_aproc_attach, int, aproc_fd, int, pidfd)
+{
+	struct aok_aproc *aproc;
+	struct aok_handle *handle;
+	struct fd f, pf;
+	struct pid *pid;
+	struct task_struct *task;
+	int ret;
+
+	f = fdget(aproc_fd);
+	if (fd_empty(f))
+		return -EBADF;
+	if (fd_file(f)->f_op != &aok_aproc_fops) {
+		fdput(f);
+		return -EINVAL;
+	}
+	handle = fd_file(f)->private_data;
+	aproc = handle->aproc;
+	if (!(handle->rights & AOK_RIGHT_ATTACH)) {
+		fdput(f);
+		return -EACCES;
+	}
+	pf = fdget(pidfd);
+	if (fd_empty(pf)) {
+		fdput(f);
+		return -EBADF;
+	}
+	/*
+	 * PID numbers never take part in authorization: the pidfd resolves
+	 * the task, then namespace, job state and membership are checked.
+	 */
+	pid = pidfd_pid(fd_file(pf));
+	if (IS_ERR(pid)) {
+		fdput(pf);
+		fdput(f);
+		return -EINVAL;
+	}
+	task = get_pid_task(pid, PIDTYPE_PID);
+	if (!task) {
+		ret = -ESRCH;
+		goto out_fds;
+	}
+	/* task_lock pairs with aok_task_exit(); see its comment. */
+	task_lock(task);
+	if (task->flags & PF_EXITING || !task->mm ||
+	    task == current || task->aok_aproc) {
+		ret = task == current ? -EINVAL :
+		      task->aok_aproc ? -EBUSY : -ESRCH;
+		task_unlock(task);
+		put_task_struct(task);
+		goto out_fds;
+	}
+	if (task_active_pid_ns(task) != task_active_pid_ns(current)) {
+		task_unlock(task);
+		put_task_struct(task);
+		ret = -EPERM;
+		goto out_fds;
+	}
+	spin_lock(&aproc->lock);
+	ret = aok_join_locked(aproc, task);
+	spin_unlock(&aproc->lock);
+	task_unlock(task);
+	put_task_struct(task);
+out_fds:
+	fdput(pf);
+	fdput(f);
+	return ret;
+}
+
+static struct task_struct **
+aok_collect_tasks(struct aok_aproc *aproc, unsigned int *countp)
+{
+	struct task_struct *t, **tasks;
+	unsigned long n;
+
+again:
+	spin_lock(&aproc->lock);
+	n = aproc->ntasks;
+	spin_unlock(&aproc->lock);
+	tasks = kvmalloc_array(n + 1, sizeof(*tasks), GFP_KERNEL);
+	if (!tasks)
+		return ERR_PTR(-ENOMEM);
+	spin_lock(&aproc->lock);
+	if (aproc->ntasks > n) {
+		spin_unlock(&aproc->lock);
+		kvfree(tasks);
+		goto again;
+	}
+	*countp = 0;
+	list_for_each_entry(t, &aproc->tasks, aok_tasks) {
+		get_task_struct(t);
+		tasks[(*countp)++] = t;
+	}
+	spin_unlock(&aproc->lock);
+	return tasks;
+}
+
+static void aok_put_tasks(struct task_struct **tasks, unsigned int count)
+{
+	unsigned int i;
+
+	for (i = 0; i < count; i++)
+		put_task_struct(tasks[i]);
+	kvfree(tasks);
+}
