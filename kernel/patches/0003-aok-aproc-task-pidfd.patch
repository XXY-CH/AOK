+	};
+	struct aok_handle *handle;
+	struct aok_aproc *aproc;
+	struct fd f;
+
+	f = fdget(fd);
+	if (fd_empty(f))
+		return -EBADF;
+	if (fd_file(f)->f_op != &aok_aproc_fops) {
+		fdput(f);
+		return -EINVAL;
+	}
+	handle = fd_file(f)->private_data;
+	aproc = handle->aproc;
+	if (!(handle->rights & AOK_RIGHT_INSPECT)) {
+		fdput(f);
+		return -EACCES;
+	}
+	spin_lock(&aproc->lock);
+	status.aid = aproc->aid;
+	status.state = aproc->state;
+	status.task_count = aproc->ntasks;
+	status.task_total = aproc->task_total;
+	status.event_seq = aproc->event_seq;
+	status.events_dropped = aproc->events_dropped;
+	status.rights_ceiling = aproc->rights_ceiling;
+	spin_unlock(&aproc->lock);
+	fdput(f);
+	return aok_copy_status(ustatus, &status);
+}
