+SYSCALL_DEFINE1(aok_aproc_reap, int, fd)
+{
+	struct aok_handle *handle;
+	struct aok_aproc *aproc;
+	struct fd f;
+
+	f = fdget(fd);
+	if (fd_empty(f))
+		return -EBADF;
+	if (fd_file(f)->f_op != &aok_aproc_fops) {
+		fdput(f);
+		return -EINVAL;
+	}
+	handle = fd_file(f)->private_data;
+	aproc = handle->aproc;
+	if (!(handle->rights & AOK_RIGHT_DESTROY)) {
+		fdput(f);
+		return -EACCES;
+	}
+	spin_lock(&aproc->lock);
+	switch (aproc->state) {
+	case AOK_APROC_STATE_EXITED:
+	case AOK_APROC_STATE_FAILED:
+		aproc->state = AOK_APROC_STATE_REAPED;
+		aok_emit_locked(aproc, AOK_EVENT_STATE, 0);
+		break;
+	case AOK_APROC_STATE_REAPED:
+		break;
+	default:
+		spin_unlock(&aproc->lock);
+		fdput(f);
+		return -EBUSY;
+	}
+	spin_unlock(&aproc->lock);
+	fdput(f);
+	return 0;
+}
