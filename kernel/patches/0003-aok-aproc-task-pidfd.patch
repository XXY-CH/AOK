+/* Resolve the parent capability and compute the child rights ceiling. */
+static int aok_parent_ceiling(int parent_fd, u64 *ceiling)
+{
+	struct fd parent = fdget(parent_fd);
+	struct aok_handle *parent_handle;
+	u64 limit = AOK_RIGHTS_APROC_INITIAL;
