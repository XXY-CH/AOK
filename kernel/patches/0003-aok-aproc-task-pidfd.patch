+static ssize_t aok_aproc_read(struct file *file, char __user *buf,
+			      size_t count, loff_t *ppos)
+{
+	struct aok_handle *handle = file->private_data;
+	struct aok_aproc *aproc = handle->aproc;
+	struct aok_aproc_event ev = { .size = sizeof(ev) };
+	const struct aok_event_slot *slot;
