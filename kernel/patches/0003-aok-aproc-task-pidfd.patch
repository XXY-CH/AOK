+SYSCALL_DEFINE2(aok_aproc_spawn, int, aproc_fd,
+		const struct aok_task_spawn_attr __user *, uattr)
+{
+	struct aok_task_spawn_attr attr;
+	struct kernel_clone_args kargs = { .exit_signal = SIGCHLD };
+	struct aok_spawn_req req = {};
+	struct aok_aproc *aproc;
+	struct aok_handle *handle;
+	struct fd f;
+	long nr;
+	int ret;
+
+	ret = aok_copy_spawn_attr(&attr, uattr);
+	if (ret)
+		return ret;
+	f = fdget(aproc_fd);
+	if (fd_empty(f))
+		return -EBADF;
+	if (fd_file(f)->f_op != &aok_aproc_fops) {
+		fdput(f);
+		return -EINVAL;
+	}
+	handle = fd_file(f)->private_data;
+	aproc = handle->aproc;
+	if (!(handle->rights & AOK_RIGHT_MANAGE_CHILD)) {
+		fdput(f);
+		return -EACCES;
+	}
+	spin_lock(&aproc->lock);
+	if (aproc->state != AOK_APROC_STATE_RUNNING) {
+		spin_unlock(&aproc->lock);
+		fdput(f);
+		return -EINVAL;
+	}
+	spin_unlock(&aproc->lock);
+	/* Probe pidfd availability so fd exhaustion fails before the fork. */
+	ret = get_unused_fd_flags(O_CLOEXEC);
+	if (ret < 0) {
+		fdput(f);
+		return ret;
+	}
+	put_unused_fd(ret);
+
+	req.aproc = aproc;
+	current->aok_spawn = &req;
+	nr = kernel_clone(&kargs);
+	current->aok_spawn = NULL;
+	fdput(f);
+	if (nr == 0)
+		return 0;
+	if (nr < 0)
+		return nr;
+	ret = aok_pidfd_for(req.task, &req.pidfd_file);
+	if (ret < 0) {
+		send_sig(SIGKILL, req.task, 0);
+		put_task_struct(req.task);
+		return ret;
+	}
+	req.pidfd = ret;
+	fd_install(req.pidfd, req.pidfd_file);
+	put_task_struct(req.task);
+	return req.pidfd;
+}
