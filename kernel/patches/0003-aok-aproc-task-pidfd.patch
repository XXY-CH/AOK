+	parent_handle = fd_file(parent)->private_data;
+	if (!(parent_handle->rights & AOK_RIGHT_MANAGE_CHILD)) {
+		fdput(parent);
+		return -EACCES;
+	}
+	if (parent_handle->aproc) {
+		spin_lock(&parent_handle->aproc->lock);
+		if (parent_handle->aproc->state != AOK_APROC_STATE_RUNNING) {
+			spin_unlock(&parent_handle->aproc->lock);
+			fdput(parent);
+			return -EINVAL;
+		}
+		spin_unlock(&parent_handle->aproc->lock);
+		limit &= parent_handle->rights;
+	}
+	fdput(parent);
+	*ceiling = limit;
+	return 0;
