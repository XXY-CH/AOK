+SYSCALL_DEFINE1(aok_aproc_freeze, int, fd)
+{
+	struct task_struct **tasks;
+	struct aok_handle *handle;
+	struct aok_aproc *aproc;
+	unsigned int count, i;
+	struct fd f;
+	bool transitioned;
+
+	f = fdget(fd);
+	if (fd_empty(f))
+		return -EBADF;
+	if (fd_file(f)->f_op != &aok_aproc_fops) {
+		fdput(f);
+		return -EINVAL;
+	}
+	handle = fd_file(f)->private_data;
+	aproc = handle->aproc;
+	if (!(handle->rights & AOK_RIGHT_SIGNAL)) {
+		fdput(f);
+		return -EACCES;
+	}
+	spin_lock(&aproc->lock);
+	if (aproc->state == AOK_APROC_STATE_FROZEN) {
+		spin_unlock(&aproc->lock);
+		fdput(f);
+		return 0;
+	}
+	if (aproc->state != AOK_APROC_STATE_RUNNING) {
+		spin_unlock(&aproc->lock);
+		fdput(f);
+		return -EINVAL;
+	}
+	spin_unlock(&aproc->lock);
+
+	/*
+	 * Collect the members before committing the transition: an
+	 * allocation failure here leaves the aproc RUNNING and the call
+	 * retryable, instead of committing FROZEN with nobody frozen.
+	 */
+	tasks = aok_collect_tasks(aproc, &count);
+	if (IS_ERR(tasks)) {
+		fdput(f);
+		return PTR_ERR(tasks);
+	}
+
+	spin_lock(&aproc->lock);
+	transitioned = false;
+	if (aproc->state == AOK_APROC_STATE_RUNNING) {
+		aproc->state = AOK_APROC_STATE_FROZEN;
+		aproc->freeze_req = true;
+		aok_emit_locked(aproc, AOK_EVENT_STATE, 0);
+		transitioned = true;
+	} else if (aproc->state != AOK_APROC_STATE_FROZEN) {
+		/* Lost a race with abort/reap; touch nothing. */
+		spin_unlock(&aproc->lock);
+		aok_put_tasks(tasks, count);
+		fdput(f);
+		return -EINVAL;
+	}
+	spin_unlock(&aproc->lock);
+
+	/*
+	 * The static key pairs with resume/abort of the same freeze, so only
+	 * the caller that performed the transition takes a reference.
+	 */
+	if (transitioned)
+		aok_freezer_enter();
+	for (i = 0; i < count; i++) {
+		WRITE_ONCE(tasks[i]->aok_freeze, true);
+		freeze_task(tasks[i]);
+	}
+	aok_put_tasks(tasks, count);
+	fdput(f);
+	return 0;
+}
+
+SYSCALL_DEFINE1(aok_aproc_resume, int, fd)
+{
+	struct task_struct **tasks;
+	struct aok_handle *handle;
+	struct aok_aproc *aproc;
+	unsigned int count, i;
+	struct fd f;
+	bool transitioned;
+	u32 state_after;
+
+	f = fdget(fd);
+	if (fd_empty(f))
+		return -EBADF;
+	if (fd_file(f)->f_op != &aok_aproc_fops) {
+		fdput(f);
+		return -EINVAL;
+	}
+	handle = fd_file(f)->private_data;
+	aproc = handle->aproc;
+	if (!(handle->rights & AOK_RIGHT_SIGNAL)) {
+		fdput(f);
+		return -EACCES;
+	}
+	spin_lock(&aproc->lock);
+	if (aproc->state != AOK_APROC_STATE_FROZEN) {
+		spin_unlock(&aproc->lock);
+		fdput(f);
+		return -EINVAL;
+	}
+	spin_unlock(&aproc->lock);
+
+	/*
+	 * Collect before transitioning: on failure the aproc stays FROZEN
+	 * and the freezer reference is untouched, leaving the call
+	 * retryable instead of stranding frozen tasks with no static key.
+	 */
+	tasks = aok_collect_tasks(aproc, &count);
+	if (IS_ERR(tasks)) {
+		fdput(f);
+		return PTR_ERR(tasks);
+	}
+
+	spin_lock(&aproc->lock);
+	transitioned = false;
+	state_after = aproc->state;
+	if (state_after == AOK_APROC_STATE_FROZEN) {
+		aproc->state = AOK_APROC_STATE_RUNNING;
+		aproc->freeze_req = false;
+		aok_emit_locked(aproc, AOK_EVENT_STATE, 0);
+		transitioned = true;
+		state_after = AOK_APROC_STATE_RUNNING;
+	}
+	spin_unlock(&aproc->lock);
+
+	for (i = 0; i < count; i++) {
+		WRITE_ONCE(tasks[i]->aok_freeze, false);
+		__thaw_task(tasks[i]);
+	}
+	aok_put_tasks(tasks, count);
+	/* Pairs with the freeze that transitioned into FROZEN. */
+	if (transitioned)
+		aok_freezer_leave();
+	fdput(f);
+	/* No runtime checkpoint registry exists in this slice. */
+	return state_after == AOK_APROC_STATE_RUNNING ?
+	       AOK_RESUME_RECOVERY_NONE : -EINVAL;
+}
+
+SYSCALL_DEFINE1(aok_aproc_abort, int, fd)
+{
+	struct task_struct **tasks;
+	struct aok_handle *handle;
+	struct aok_aproc *aproc;
+	unsigned int count, i;
+	struct fd f;
+	bool transitioned;
+	bool was_frozen;
+
+	f = fdget(fd);
+	if (fd_empty(f))
+		return -EBADF;
+	if (fd_file(f)->f_op != &aok_aproc_fops) {
+		fdput(f);
+		return -EINVAL;
+	}
+	handle = fd_file(f)->private_data;
+	aproc = handle->aproc;
+	if (!(handle->rights & AOK_RIGHT_SIGNAL)) {
+		fdput(f);
+		return -EACCES;
+	}
+	spin_lock(&aproc->lock);
+	if (aproc->state == AOK_APROC_STATE_FAILED) {
+		spin_unlock(&aproc->lock);
+		fdput(f);
+		return 0;
+	}
+	if (aproc->state == AOK_APROC_STATE_REAPED) {
+		spin_unlock(&aproc->lock);
+		fdput(f);
+		return -EINVAL;
+	}
+	spin_unlock(&aproc->lock);
+
+	/*
+	 * Collect before committing FAILED: an allocation failure leaves the
+	 * previous state intact instead of a terminal FAILED aproc whose
+	 * tasks were never terminated.
+	 */
+	tasks = aok_collect_tasks(aproc, &count);
+	if (IS_ERR(tasks)) {
+		fdput(f);
+		return PTR_ERR(tasks);
+	}
+
+	spin_lock(&aproc->lock);
+	transitioned = false;
+	was_frozen = false;
+	if (aproc->state == AOK_APROC_STATE_FAILED) {
+		spin_unlock(&aproc->lock);
+		aok_put_tasks(tasks, count);
+		fdput(f);
+		return 0;
+	}
+	if (aproc->state != AOK_APROC_STATE_REAPED) {
+		was_frozen = aproc->state == AOK_APROC_STATE_FROZEN;
+		aproc->state = AOK_APROC_STATE_FAILED;
+		aproc->freeze_req = false;
+		aok_emit_locked(aproc, AOK_EVENT_STATE, 0);
+		transitioned = true;
+	}
+	spin_unlock(&aproc->lock);
+
+	if (transitioned) {
+		for (i = 0; i < count; i++) {
+			WRITE_ONCE(tasks[i]->aok_freeze, false);
+			__thaw_task(tasks[i]);
+			send_sig(SIGKILL, tasks[i], 0);
+		}
+	}
+	aok_put_tasks(tasks, count);
+	/* Pairs with the freeze that transitioned into FROZEN. */
+	if (transitioned && was_frozen)
+		aok_freezer_leave();
+	fdput(f);
+	return 0;
+}
