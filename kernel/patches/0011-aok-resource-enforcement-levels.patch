--- a/kernel/aok.c
+++ b/kernel/aok.c
@@ -981,6 +981,21 @@ static void aok_force_freeze(struct aok_aproc *aproc)
  * enforcement path in this slice; racy reads approximate per-task counters
  * without perturbing the scheduler or reclaim.
  */
+/* Per-resource enforcement level: within -> throttle -> freeze. `div` is
+ * the throttle denominator (5 = 80% for tokens, 10 = 90% for observed
+ * CPU/RSS). The kernel freezes at the limit; the throttle band is policy.
+ */
+static u32 aok_res_level(u64 limit, u64 used, u32 div)
+{
+	if (limit == U64_MAX)
+		return AOK_RES_LEVEL_WITHIN;
+	if (used >= limit)
+		return AOK_RES_LEVEL_FREEZE;
+	if (used >= limit - div64_u64(limit, div))
+		return AOK_RES_LEVEL_THROTTLE;
+	return AOK_RES_LEVEL_WITHIN;
+}
