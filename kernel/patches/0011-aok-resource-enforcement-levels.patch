diff --git a/include/uapi/linux/aok.h b/include/uapi/linux/aok.h
index a2c41ec9d..7c282894a 100644
--- a/include/uapi/linux/aok.h
+++ b/include/uapi/linux/aok.h
@@ -59,6 +59,19 @@
 #define AOK_RES_STATE_PRESSURE 1U
 #define AOK_RES_STATE_OVER 2U
 
+/*
+ * Per-resource enforcement levels, monotonically within -> throttle ->
+ * freeze. Tokens enter throttle at 80% of the hard limit; observed CPU
+ * and RSS at 90% of their limits. FREEZE reports that the resource is at
+ * or over its limit: observed CPU/RSS freeze immediately at budget_get,
+ * while tokens freeze fail-closed on the next usage report that settles
+ * over the hard limit. The throttle band is reported for admission
+ * policy (runtime rate limiting).
+ */
+#define AOK_RES_LEVEL_WITHIN 0U
+#define AOK_RES_LEVEL_THROTTLE 1U
+#define AOK_RES_LEVEL_FREEZE 2U
+
 /*
  * Minimal first-task ABI of this slice: the first task of aok_aproc_create()
  * and every aok_aproc_spawn() task is a fork of the caller. The child returns
@@ -135,8 +145,10 @@ struct aok_budget_status {
 	__u64 tokens_used;
 	__u64 tokens_cached;
 	__u32 res_state;
-	__u32 reserved;
-	__u64 reserved2[2];
+	__u32 cpu_level;
+	__u32 memory_level;
+	__u32 token_level;
+	__u64 reserved;
 };
 
