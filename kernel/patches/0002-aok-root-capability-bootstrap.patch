+}
+
+static const struct file_operations aok_root_fops = {
+	.owner = THIS_MODULE,
+	.release = aok_root_cap_release,
+};
+
+SYSCALL_DEFINE0(aok_root_cap_claim)
+{
+	struct aok_handle *handle;
+	int fd;
+
+	if (task_tgid_nr(current) != 1)	/* tgid: threaded PID1 may claim */
+		return -EPERM;
+	handle = kzalloc(sizeof(*handle), GFP_KERNEL);
+	if (!handle)
+		return -ENOMEM;
+	mutex_lock(&aok_root_lock);
+	if (aok_root_claimed) {
+		mutex_unlock(&aok_root_lock);
+		kfree(handle);
+		return -EALREADY;
+	}
+	aok_root_claimed = true;
+	mutex_unlock(&aok_root_lock);
+	handle->rights = AOK_RIGHTS_ROOT;
+	handle->type = AOK_OBJECT_ROOT_JOB;
+	fd = anon_inode_getfd("aok-root-job", &aok_root_fops, handle, O_RDWR | O_CLOEXEC);
+	if (fd < 0) {
+		kfree(handle);
+		mutex_lock(&aok_root_lock);
+		aok_root_claimed = false;
+		mutex_unlock(&aok_root_lock);
+		return fd;
+	}
+	return fd;
+}
